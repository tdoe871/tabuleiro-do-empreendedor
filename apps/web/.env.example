# ==========================================
# Tabuleiro do Empreendedor - Environment Variables
# ==========================================

# Application. In production, the real public URL: password reset emails
# build their link from it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E2E tests only (Playwright), NOT for the app and NOT set in this file:
# pass it on the command line to run the @readonly tests against a deployed
# site instead of localhost, e.g. in PowerShell:
#   $env:E2E_BASE_URL="https://tabuleiro-do-empreendedor.vercel.app"; pnpm test:e2e
# E2E_BASE_URL=
#
# Full journeys (sign up, sessions, teams, board, chat, deliveries, mentors):
# they create real rows in the DATABASE_URL database, all marked E2E- /
# @e2e.test and deleted before and after the run. Off unless E2E_DB=1, and
# never run against E2E_BASE_URL. In PowerShell:
#   $env:E2E_DB="1"; pnpm test:e2e
# E2E_PORT runs the local test server on another port (default 3000).

# Database (Supabase Postgres via Prisma). Both go through the Supabase pooler:
# DATABASE_URL — transaction mode, port 6543: what the app uses.
# DIRECT_URL   — session mode, port 5432: only for migrations (prisma.config.ts).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Connections per server instance (default 5). Vercel: 3-5. One VM: 10-20.
DATABASE_POOL_MAX=

# Supabase (Storage for team submissions, Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# Publishable key (sb_publishable_...): safe in the browser, tables are protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): SERVER ONLY, bypasses RLS. Not needed for local frontend work.
SUPABASE_SECRET_KEY=

# Realtime (apps/web/src/lib/realtime/server.ts): "supabase" | "none".
# Optional: when empty it uses Supabase Broadcast if the keys above exist,
# and plain polling ("none") if they do not. Changing it needs no code change.
REALTIME_PROVIDER=

# Auth (sessions signed with jose, same pattern as Maestro-virtual)
AUTH_SECRET=

# Email (Resend) — apps/web/src/lib/email/send.ts. Optional in development:
# without them, emails are printed to the terminal instead of sent.
# MAIL_FROM must use a domain verified in Resend, e.g. "Tabuleiro <no-reply@tu-dominio.com>".
RESEND_API_KEY=
MAIL_FROM=
