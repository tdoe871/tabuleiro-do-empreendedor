# ==========================================
# Tabuleiro do Empreendedor - Environment Variables
# ==========================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Supabase Postgres via Prisma)
DATABASE_URL=postgresql://usuario:[PASSWORD]@servidor-pooler:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://usuario:[PASSWORD]@servidor:5432/postgres

# Supabase (Storage for team submissions/images, optional Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth (sessions signed with jose, same pattern as Maestro-virtual)
AUTH_SECRET=

# Email (Resend) — apps/web/src/lib/email/send.ts. Optional in development:
# without them, emails are printed to the terminal instead of sent.
# MAIL_FROM must use a domain verified in Resend, e.g. "Tabuleiro <no-reply@tu-dominio.com>".
RESEND_API_KEY=
MAIL_FROM=
