# ==========================================
# Tabuleiro do Empreendedor - Environment Variables
# ==========================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Supabase Postgres via Prisma)
# DATABASE_URL: transaction-mode pooler (port 6543) — used by the running app.
# DIRECT_URL: session-mode pooler (port 5432) — used by `prisma migrate`/CLI only.
DATABASE_URL=postgresql://usuario:[PASSWORD]@servidor-pooler:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://usuario:[PASSWORD]@servidor:5432/postgres

# Supabase (Storage for team submissions/images, optional Realtime/Auth).
# Not read by any code yet — provisioned ahead of that work. Current
# Supabase projects issue "publishable"/"secret" keys (replacing the old
# anon/service_role naming) plus a JWKS URL for the new asymmetric keys.
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side copies (same project, used outside the browser bundle)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json

# Auth (sessions signed with jose, same pattern as Maestro-virtual). Required —
# apps/web/src/lib/auth/session.ts throws if this is unset.
AUTH_SECRET=

# Email (Resend) — optional for now. Only used for staff account recovery,
# not the participant join flow, and that flow isn't built yet either.
RESEND_API_KEY=
MAIL_FROM=
