generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Staff (the "maestro" / event host). A Student/Participant does NOT need a
// password — they join with an event code + nickname, matching the flow
// redesign in docs/architecture/DECISIONS-UX.md.
// ---------------------------------------------------------------------------
model Staff {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  hashedPassword String
  events         Event[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// PAUSED does not stop the clock: endsAt stays the same and participants just
// cannot act until the event is ACTIVE again.
enum EventStatus {
  DRAFT
  ACTIVE
  PAUSED
  FINISHED
}

// Picked when the educator creates the session. SCHOOL uses the standard
// scenario; CUSTOM comes with the educator's own scenario text.
enum EventMode {
  SCHOOL
  CUSTOM
}

// Per UX fix #3: a hackathon needs ONE countdown for the whole event, not a
// countdown per phase. GLOBAL uses Event.durationMinutes from Event.startedAt;
// PER_PHASE uses each Phase.durationMinutes, like the original prototype.
enum TimerMode {
  GLOBAL
  PER_PHASE
}

model Event {
  id              String      @id @default(uuid())
  code            String      @unique // short code to join as a participant
  // Short code the educator shares with the event's mentors (judges). Null
  // until the educator creates it; regenerating it stops new entries.
  mentorCode      String?     @unique
  name            String
  mode            EventMode   @default(SCHOOL)
  scenario        String? // required when mode = CUSTOM
  status          EventStatus @default(DRAFT)
  timerMode       TimerMode   @default(GLOBAL)
  durationMinutes Int? // used when timerMode = GLOBAL
  maxTeams        Int         @default(60)
  maxTeamSize     Int         @default(5)
  startedAt       DateTime?
  endsAt          DateTime?
  hostId          String
  host            Staff       @relation(fields: [hostId], references: [id])
  phases          Phase[]
  teams           Team[]
  alerts          Alert[]
  mentors         Mentor[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // `code` is already indexed by @unique; hostId backs the FK to Staff.
  @@index([hostId])
}

// The 4 "chaves" of the board. Lowercased, they match KEY_IDS in
// apps/web/src/features/event/keys.ts.
enum BoardKey {
  PROBLEMA
  SOLUCAO
  PARCERIAS
  OPORTUNIDADES
}

// Each chave has 3 phases (order 1-3), so an event has 12 phases. The phase
// name and question live in the i18n dictionaries (jogador.fases.<key>[order-1])
// because the app ships in 4 languages; name/prompt here are optional
// overrides. The standard set is BOARD_PHASES in src/board.ts.
model Phase {
  id              String      @id @default(uuid())
  eventId         String
  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  key             BoardKey
  order           Int // 1-3 within the chave
  name            String?
  prompt          String? // "carta-desafio" — the challenge question/card
  durationMinutes Int? // only relevant when Event.timerMode = PER_PHASE
  teamProgress    TeamPhase[]

  @@unique([eventId, key, order])
}

// Per UX fix #2: a team has a real name chosen at creation, plus its own
// short joinCode (and an invite link built from it) so members join THAT
// team instead of guessing a raw number. The first participant to create a
// team becomes its leader automatically.
model Team {
  id            String           @id @default(uuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  joinCode      String           @unique
  score         Int              @default(0)
  participants  Participant[]
  phaseProgress TeamPhase[]
  submission    Submission?
  files         SubmissionFile[]
  messages      Message[]
  evaluations   Evaluation[]
  createdAt     DateTime         @default(now())

  @@unique([eventId, name])
}

enum ParticipantRole {
  LEADER
  MEMBER
}

model Participant {
  id               String           @id @default(uuid())
  teamId           String
  team             Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nickname         String
  role             ParticipantRole  @default(MEMBER)
  rpgRole          String? // optional gamification role, kept from the original prototype
  joinedAt         DateTime         @default(now())
  completedPhases  TeamPhase[]
  uploadedFiles    SubmissionFile[]
  sentMessages     Message[]        @relation("MessageSender")
  receivedMessages Message[]        @relation("MessageRecipient")

  @@unique([teamId, nickname])
}

model TeamPhase {
  id            String       @id @default(uuid())
  teamId        String
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  phaseId       String
  phase         Phase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  content       String? // the team's answer to the phase question
  completedAt   DateTime?
  // Who answered it (any team member can). Kept for the activity record.
  completedById String?
  completedBy   Participant? @relation(fields: [completedById], references: [id], onDelete: SetNull)
  pointsAwarded Int          @default(0)

  @@unique([teamId, phaseId])
  @@index([phaseId])
  @@index([completedById])
}

// Per UX fix #1: teams need a place to deliver their project. Most hackathon
// teams will paste a deployment link (Vercel/Netlify/etc.); teams without
// code can instead attach a presentation/image. "If the deploy link doesn't
// work, that's on the team" — no file execution happens on our side.
enum SubmissionType {
  DEPLOY_LINK
  REPO_LINK
  FILE_OR_IMAGE
  NONE
}

model Submission {
  id          String         @id @default(uuid())
  teamId      String         @unique
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type        SubmissionType @default(NONE)
  url         String? // main link: deploy link or repo link
  links       String[]       @default([]) // extra links (other pages, slides, video)
  fileUrl     String? // unused: files live in SubmissionFile
  description String?
  submittedAt DateTime?
  updatedAt   DateTime       @updatedAt
}

enum SubmissionFileStatus {
  PENDING // upload URL issued, not confirmed yet
  READY // uploaded and its content checked
}

// Files a team uploads for its delivery (PDF, Word, slides, images). They
// live in the private "submissions" Storage bucket at `path`; downloads go
// through short-lived signed URLs.
model SubmissionFile {
  id           String               @id @default(uuid())
  teamId       String
  team         Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  path         String               @unique // object path inside the bucket
  fileName     String // original name, for display and download
  contentType  String
  size         Int
  status       SubmissionFileStatus @default(PENDING)
  uploadedById String?
  uploadedBy   Participant?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())

  @@index([teamId])
  @@index([uploadedById])
}

// Team chat. TEAM goes to the whole team; PRIVATE and NUDGE ("toque", to get
// a teammate's attention) go to one teammate and only the sender and the
// recipient see them.
enum MessageType {
  TEAM
  PRIVATE
  NUDGE
}

// The id is sequential so clients can poll with GET /api/messages?after=<id>.
// clientId is generated by the sender's device: resending the same message
// after a dropped connection does not create a duplicate.
model Message {
  id          Int          @id @default(autoincrement())
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type        MessageType
  text        String? // null for NUDGE
  senderId    String?
  sender      Participant? @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipientId String? // PRIVATE and NUDGE only
  recipient   Participant? @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  clientId    String
  createdAt   DateTime     @default(now())

  @@unique([senderId, clientId])
  @@index([teamId, id])
  @@index([recipientId])
}

// A mentor (judge) of one event. Like players, mentors have no password:
// they enter with the event's mentorCode and their name, and the same name
// recovers the session.
model Mentor {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  evaluations Evaluation[]
  joinedAt    DateTime     @default(now())

  @@unique([eventId, name])
}

// One mentor's grade for one team. `scores` maps each rubric criterion to a
// 1-5 score; the rubric lives in code (features/mentor/server/rubric.ts) so
// it can change without a migration.
model Evaluation {
  id        String   @id @default(uuid())
  mentorId  String
  mentor    Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  scores    Json
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mentorId, teamId])
  @@index([teamId])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id         String        @id @default(uuid())
  eventId    String
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  severity   AlertSeverity @default(INFO)
  message    String
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([eventId])
}
